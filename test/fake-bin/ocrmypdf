#!/usr/bin/env node
/**
 * A stand-in for ocrmypdf, used only by test/ocr.test.js.
 *
 * src/ocr-args.js's buildSidecarOcrArgs restricts every real page invocation to one
 * page, so this only has to answer one question: what should the --sidecar transcript
 * be? That comes from FAKE_OCR_SIDECAR, a JSON object keyed by page or slide number as a
 * string, an env var each test case sets. A page missing from it gets an empty
 * transcript — OCR ran and found nothing, a real and unremarkable outcome, not a stub
 * bug needing special-casing.
 *
 * The key itself comes from the input filename first, not --pages — src/ocr.js names
 * every picture it wraps as its own one-page PDF s<N>-<i>.pdf (see wrapImageAsPdf in
 * src/ocr-pdf.js), so --pages is always "1" there regardless of which slide it came
 * from, and only the filename still says which slide it actually is. A real multi-page
 * PDF being OCR'd page by page has no such name, so --pages is the fallback for it.
 *
 * The output PDF this is also asked to write is never read by src/ocr.js — see
 * src/ocr-pdf.js's doc comment for why — so a minimal placeholder is enough to exist at
 * the path ocrmypdf is required to write one to.
 */
const fs = require('fs');

if (process.argv.includes('--version')) {
  console.log('fake-ocrmypdf 0.0.0 (test stub)');
  process.exit(0);
}

if (process.env.FAKE_OCR_FAIL) {
  process.stderr.write(process.env.FAKE_OCR_FAIL + '\n');
  process.exit(1);
}

const argv = process.argv.slice(2);
const sidecarPath = argv[argv.indexOf('--sidecar') + 1];
const outputPath = argv[argv.length - 1];
const inputPath = argv[argv.length - 2];

const pagesIndex = argv.indexOf('--pages');
const fromFilename = (require('path').basename(inputPath).match(/^s(\d+)-/) || [])[1];
const key = fromFilename || (pagesIndex !== -1 ? argv[pagesIndex + 1] : undefined);

const transcripts = JSON.parse(process.env.FAKE_OCR_SIDECAR || '{}');
fs.writeFileSync(sidecarPath, transcripts[key] || '', 'utf8');
fs.writeFileSync(outputPath, '%PDF-1.4\n%%EOF\n', 'latin1');
