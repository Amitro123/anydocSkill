#!/usr/bin/env node
/**
 * A stand-in for ocrmypdf, used only by test/ocr.test.js.
 *
 * src/ocr-args.js's buildSidecarOcrArgs restricts every real invocation to one page, so
 * this only has to answer one question: what should the --sidecar transcript for
 * --pages N be? That comes from FAKE_OCR_SIDECAR, a JSON object keyed by page number as
 * a string, an env var each test case sets. A page missing from it gets an empty
 * transcript — OCR ran and found nothing, a real and unremarkable outcome, not a stub
 * bug needing special-casing.
 *
 * The output PDF this is also asked to write is never read by src/ocr.js — see
 * src/ocr-pdf.js's doc comment for why — so a minimal placeholder is enough to exist at
 * the path ocrmypdf is required to write one to.
 */
const fs = require('fs');

if (process.argv.includes('--version')) {
  console.log('fake-ocrmypdf 0.0.0 (test stub)');
  process.exit(0);
}

if (process.env.FAKE_OCR_FAIL) {
  process.stderr.write(process.env.FAKE_OCR_FAIL + '\n');
  process.exit(1);
}

const argv = process.argv.slice(2);
const page = argv[argv.indexOf('--pages') + 1];
const sidecarPath = argv[argv.indexOf('--sidecar') + 1];
const outputPath = argv[argv.length - 1];

const transcripts = JSON.parse(process.env.FAKE_OCR_SIDECAR || '{}');
fs.writeFileSync(sidecarPath, transcripts[page] || '', 'utf8');
fs.writeFileSync(outputPath, '%PDF-1.4\n%%EOF\n', 'latin1');
